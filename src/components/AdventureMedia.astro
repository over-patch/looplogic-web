---
import Screenshot from './Screenshot.astro';
interface Props { ja: boolean; videoSrc?: string; poster?: string; captionsSrc?: string; }
const { ja, videoSrc, poster, captionsSrc } = Astro.props;
---
    <figure class="adventure-preview" data-media-slot="adventure-hero">{videoSrc ? <video controls playsinline preload="none" poster={poster} aria-label={ja ? "アドベンチャーモードの紹介動画" : "Adventure Mode introduction"}><source src={videoSrc} type="video/mp4" />{captionsSrc && <track kind="captions" src={captionsSrc} srclang={ja ? "ja" : "en"} label={ja ? "日本語" : "English"} default />}</video> : <div class="preview-screens"><Screenshot src="/images/buffs.jpg" ja={ja} alt={ja ? 'バフを選ぶ画面' : 'Choose a buff (Japanese)'} /><Screenshot src="/images/adventure.jpg" ja={ja} alt={ja ? 'アドベンチャーの攻略画面' : 'Adventure gameplay (Japanese)'} /></div>}</figure>
