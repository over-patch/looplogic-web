---
interface Props { screen: 'standard' | 'adventure' | 'buffs'; alt: string; ja: boolean; eager?: boolean; }
const { screen, alt, ja, eager = false } = Astro.props;
const src = `/images/screenshots/${ja ? 'ja' : 'en'}/${screen}.png`;
---
<div class="app-screen">
 <img src={src} width="1206" height="2622" alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
</div>
