---
import '../styles/global.css';
import '../styles/adventure.css';
import '../styles/home.css';
import AdventureStory from './AdventureStory.astro';
import FirstLoop from './FirstLoop.astro';
import AppScreen from './AppScreen.astro';
import StoreLinks from './StoreLinks.astro';
import LanguageSuggestion from './LanguageSuggestion.astro';
const { lang = 'ja' } = Astro.props;
const ja = lang === 'ja';
const c = ja ? {
 title: 'Loop Logic — スマホで遊ぶ、スリザーリンク × アドベンチャー',
 description: '数字をつないで、ひとつの輪に。広告なしで楽しむスマホのロジックパズル。30,000問以上の通常モードと、強化を選んで挑むアドベンチャー。iOS・Androidで無料ダウンロード。',
} : {
 title: 'Loop Logic — Slitherlink for iOS & Android',
 description: 'Turn numbers into one satisfying loop. An ad-free mobile logic puzzle with over 30,000 puzzles and an Adventure Mode where your upgrades shape each run. Free download for iOS and Android.',
};
const canonical = `https://looplogic.overpatch.dev${ja ? '/ja/' : '/'}`;
const legal = ja ? '/ja/' : '/';
---
<!doctype html>
<html lang={lang}>
 <head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{c.title}</title><meta name="description" content={c.description} /><meta name="theme-color" content="#080b18" />
  <link rel="icon" href="/images/icon.png" type="image/png" /><link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="ja" href="https://looplogic.overpatch.dev/ja/" /><link rel="alternate" hreflang="en" href="https://looplogic.overpatch.dev/" /><link rel="alternate" hreflang="x-default" href="https://looplogic.overpatch.dev/" />
  <meta property="og:type" content="website" /><meta property="og:title" content={c.title} /><meta property="og:description" content={c.description} /><meta property="og:url" content={canonical} />
 </head>
 <body>
  <a class="skip" href="#main">{ja ? '本文へスキップ' : 'Skip to content'}</a>
  <header class="site-header"><div class="header wrap">
   <a class="brand" href={ja ? '/ja/' : '/'} aria-label="Loop Logic"><img src="/images/icon.png" width="40" height="40" alt="" /><span>Loop Logic</span></a>
   <nav aria-label={ja ? 'メインナビゲーション' : 'Main navigation'}><a href="#how">{ja ? '遊び方' : 'How to play'}</a><a href="#adventure">{ja ? 'アドベンチャー' : 'Adventure'}</a></nav>
   <div class="header-actions"><a class="language" href={ja ? '/' : '/ja/'} lang={ja ? 'en' : 'ja'} data-language-choice={ja ? 'en' : 'ja'}>{ja ? 'EN' : '日本語'}</a><a class="small-cta" href="#download">{ja ? 'ダウンロード' : 'Download'}</a></div>
  </div></header>
  <LanguageSuggestion lang={lang} />
  <main id="main" class="app-home">
   <section class="app-hero wrap" aria-labelledby="hero-title">
    <div class="app-hero-copy">
     <p class="eyebrow">{ja ? 'iOS・Androidのパズルアプリ' : 'A PUZZLE APP FOR iOS & ANDROID'}</p>
     <h1 id="hero-title">{ja ? '数字をつないで、' : 'Follow the numbers.'}<br/><span>{ja ? 'ひとつの輪に。' : 'Find your loop.'}</span></h1>
     <p class="hero-description">{ja ? 'ひらめきが、線になる。' : 'A little logic. A moment of insight.'}<br/>{ja ? '広告なしで楽しむロジックパズル。' : 'An ad-free logic puzzle, right on your phone.'}</p>
     <StoreLinks ja={ja} placement="hero" />
    </div>
    <div class="hero-product">
     <div class="hero-screens">
      <figure class="hero-phone hero-phone-main"><AppScreen src="/images/standard.jpg" alt={ja ? 'Loop Logicの通常モード。線がつながったパズルのクリア画面' : 'Loop Logic Standard Mode: a completed puzzle'} ja={ja} eager={true}/><figcaption>{ja ? 'じっくり、ひとつずつ。' : 'One satisfying puzzle.'}</figcaption></figure>
      <figure class="hero-phone hero-phone-side"><AppScreen src="/images/adventure.jpg" alt={ja ? 'Loop Logicのアドベンチャー。強化を重ねて挑むプレイ画面' : 'Loop Logic Adventure Mode: a puzzle with collected buffs'} ja={ja} eager={true}/><figcaption>{ja ? '強化を選んで、次へ。' : 'A new way to challenge yourself.'}</figcaption></figure>
     </div>
     <p class="screen-caption">{ja ? 'アプリのプレイ画面' : 'App gameplay · Japanese screens shown'}</p>
    </div>
   </section>
   <ul class="app-proof wrap" aria-label={ja ? 'アプリの特徴' : 'App features'}>
    <li><strong>{ja ? '広告なし' : 'No ads'}</strong><span>{ja ? '考えることに集中' : 'Stay in the flow'}</span></li>
    <li><strong>30,000<span>+</span></strong><span>{ja ? 'たっぷり遊べるパズル' : 'Puzzles to explore'}</span></li>
    <li><strong>{ja ? '2つのモード' : '2 ways to play'}</strong><span>{ja ? 'じっくりも、挑戦も' : 'Relax or take a challenge'}</span></li>
   </ul>
   <section id="modes" class="mode-overview section wrap" aria-labelledby="modes-title">
    <div class="section-heading"><p class="eyebrow">{ja ? '気分で選べる、2つの遊び方' : 'TWO WAYS TO PLAY'}</p><h2 id="modes-title">{ja ? 'じっくりも、挑戦も。' : 'Find your pace. Or chase a new best.'}</h2></div>
    <div class="mode-cards">
     <article class="mode-card standard-card">
      <div class="mode-copy"><p class="mode-label">{ja ? '通常モード' : 'STANDARD MODE'}</p><h3>{ja ? '気ままに、' : 'Your puzzle.'}<br/>{ja ? 'ひとつずつ。' : 'Your pace.'}</h3><p>{ja ? 'サイズと難易度を選んで、パズルに没頭。小さな一問から、難問まで。' : 'From compact grids to bigger challenges. Choose your size and difficulty, then settle into a puzzle.'}</p><ul class="mode-tags"><li>{ja ? '30,000問以上' : '30,000+ puzzles'}</li><li>{ja ? '3段階の難易度' : '3 difficulty levels'}</li></ul></div>
      <AppScreen src="/images/standard.jpg" alt={ja ? '通常モードのパズル画面' : 'A Standard Mode puzzle'} ja={ja}/>
     </article>
     <article class="mode-card adventure-card">
      <div class="mode-copy"><p class="mode-label">{ja ? 'アドベンチャー' : 'ADVENTURE MODE'}</p><h3>{ja ? '強化して、' : 'Your choices.'}<br/>{ja ? '挑もう。' : 'Your next best run.'}</h3><p>{ja ? '強化を組み合わせ、全4ステージへ。自分だけの攻略で、ベストタイムを。' : 'Pick upgrades to help you through four stages. Try a new combination and chase your best time.'}</p><a class="text-link" href="#adventure">{ja ? '強化を選ぶ楽しさを見る' : 'Explore Adventure'} <span aria-hidden="true">↗</span></a></div>
      <AppScreen src="/images/adventure.jpg" alt={ja ? 'アドベンチャーのパズルと獲得した強化' : 'An Adventure puzzle with collected upgrades'} ja={ja}/>
     </article>
    </div>
   </section>
   <AdventureStory ja={ja} />
   <section id="how" class="quick-how section wrap" aria-labelledby="how-title">
    <div class="quick-how-copy"><p class="eyebrow">{ja ? '遊び方は、シンプル' : 'SIMPLE RULES'}</p><h2 id="how-title">{ja ? '数字の数だけ線を。' : 'Match each number.'}<br/>{ja ? 'つないで、ひとつの輪に。' : 'Make one loop.'}</h2><p>{ja ? '線は枝分かれせず、ひとつにつなげます。' : 'Connect the lines without branching.'}</p></div>
    <div class="quick-how-visual"><svg class="one-loop-diagram" viewBox="0 0 300 140" role="img" aria-label={ja ? '3・2・3の数字を満たす、ひとつの輪の完成例' : 'One loop satisfying the clues 3, 2 and 3'}><path class="guide" d="M50 35H250M50 105H250M50 35V105M117 35V105M183 35V105M250 35V105"/><path class="loop" d="M50 35H250V105H50Z"/>{[3,2,3].map((n,i)=><text x={83+i*67} y="72">{n}</text>)}{[35,105].map(y=>[50,117,183,250].map(x=><circle cx={x} cy={y} r="3"/>))}</svg><span>{ja ? '数字も、輪も、そろったらクリア。' : 'Every clue met. One loop. Solved.'}</span></div>
    <details class="practice-disclosure"><summary>{ja ? 'ここで一問、試してみる' : 'Try a puzzle here'}<span aria-hidden="true">＋</span></summary><div class="practice-content"><p>{ja ? '線のつなぎ方を見てから、自分でも挑戦できます。' : 'Watch the lines connect, then give it a try.'}</p><FirstLoop ja={ja}/></div></details>
   </section>
   <section id="download" class="download section wrap"><img src="/images/icon.png" width="76" height="76" alt="" loading="lazy" /><p class="eyebrow">LOOP LOGIC</p><h2>{ja ? '次のひらめきは、' : 'Your next moment of insight.'}<br/>{ja ? 'あなたのスマホで。' : 'Right on your phone.'}</h2><p>{ja ? '一問から、無料で始めよう。' : 'Start with one puzzle. Download for free.'}</p><StoreLinks ja={ja} placement="footer" /></section>
  </main>
  <dialog class="image-dialog" aria-label={ja ? 'ゲーム画面を拡大' : 'Enlarged game screenshot'}>
   <form method="dialog"><button class="image-close" aria-label={ja ? '閉じる' : 'Close'} autofocus><span aria-hidden="true">×</span></button></form>
   <img alt="" width="1242" height="2688" />
  </dialog>
  <script>
   import '../scripts/screenshots';
   // Preserve direct links to the optional practice board.
   const revealPractice = () => {
    if (location.hash !== '#try-puzzle') return;
    const details = document.querySelector<HTMLDetailsElement>('.practice-disclosure');
    if (details) details.open = true;
    document.getElementById('try-puzzle')?.scrollIntoView();
   };
   addEventListener('hashchange', revealPractice);
   revealPractice();
  </script>
  <footer class="footer wrap"><div><a class="brand" href={ja?'/ja/':'/'}>Loop Logic</a><p>© {new Date().getFullYear()} overpatch</p></div><div class="footer-links"><a href={`${legal}privacy/`}>{ja ? 'プライバシーポリシー' : 'Privacy policy'}</a><a href={`${legal}terms/`}>{ja ? '利用規約' : 'Terms of use'}</a></div></footer>
 </body>
</html>
