---
import '../styles/global.css';
import '../styles/adventure.css';
import AdventureStory from './AdventureStory.astro';
import FirstLoop from './FirstLoop.astro';
import StoreLinks from './StoreLinks.astro';
import LanguageSuggestion from './LanguageSuggestion.astro';
const { lang = 'ja' } = Astro.props;
const ja = lang === 'ja';
const c = ja ? {
 title: 'Loop Logic — スリザーリンク × アドベンチャー', description: '数字を手がかりに、ひとつのループを完成させるロジックパズル。30,000問以上のステージとアドベンチャーモード。スマートフォン・タブレットで無料ダウンロード。',
 nav: ['遊び方', 'アドベンチャー', 'ダウンロード'], eyebrow: '数字と線のロジックパズル', headline: ['数字を手がかりに、','ひとつの輪を。'], intro: '線がつながる。ひらめきが、止まらない。広告なしで楽しむロジックパズル。', ios: 'App Storeからダウンロード', android: 'Google Playで手に入れよう', diagram: 'スリザーリンクのルール説明図', diagramNote: '数字の周りに、その数だけ線を。', rulesTitle: ['ルールはシンプル。','答えまでの道は、奥深い。'], rulesIntro: '覚えるのは、この3つ。線を引ける場所、引けない場所を見極めると、次の一手が見えてきます。', rules: [['数字の数だけ、線を引く。','マスの上下左右、4辺のうち、数字と同じ本数に線を引きます。「3」なら3辺、「0」なら1本も引きません。'],['枝分かれせず、つなぐ。','タテ・ヨコに隣り合う点を結びます。線が通る点では、必ず2本がつながるように。枝分かれや交差はできません。'],['すべての線を、ひとつの輪に。','すべての数字を満たし、引いた線がひとつの輪につながればクリア。途中で途切れたり、輪が2つ以上に分かれたりしてはいけません。']],
 proof: [['広告なし','考えることに集中'],['3段階','自分に合う難易度'],['30,000+','収録パズル']], modesTitle: ['じっくり解く日も。','挑み続けたい日も。'], standard: '自分のペースで、ひとつずつ。', standardText: 'サイズと難易度を選んで、ステージを攻略。小さな盤面から大きな難問まで、今の気分に合った一問が待っています。', standardTags: ['4×4〜16×20の盤面','3段階の難易度'], adventure: '解く力に、戦略を重ねる。', adventureText: 'ステージごとにバフを選び、自分だけの攻略を組み立てる。デイリーチャレンジやタイムランキングで、もう一歩先の挑戦へ。', adventureTags: ['32種類のバフ','デイリーチャレンジ'], galleryLabel: 'アプリのプレイ画面（現在のストア掲載画像）', endTitle: ['次の一手も、','次の選択も、あなた次第。'], endText: 'ひらめきと戦略で、次のステージへ。Loop Logicを無料で始めよう。', privacy: 'プライバシーポリシー', terms: '利用規約', skip: '本文へスキップ',
} : {
 title: 'Loop Logic — Slitherlink meets Adventure', description: 'Connect the clues into one continuous loop. Explore over 30,000 logic puzzles and Adventure Mode. Download Loop Logic for your phone or tablet for free, with in-app purchases.',
 nav: ['How to play', 'Adventure', 'Download'], eyebrow: 'A LOGIC PUZZLE OF NUMBERS AND LINES', headline: ['Follow the numbers.','Find the loop.'], intro: 'Connect the lines. Find your next moment of insight. An ad-free logic puzzle.', ios: 'Download on the App Store', android: 'Get it on Google Play', diagram: 'Slitherlink rules diagram', diagramNote: 'Each number tells you how many edges to draw.', rulesTitle: ['Simple rules.','Deeply satisfying puzzles.'], rulesIntro: 'Three rules to get started. Work out where lines can and cannot go, and your next move comes into focus.', rules: [['Match each number.','Draw lines on exactly as many of a cell’s four edges as its number says. A 3 needs three edges; a 0 needs none.'],['Connect without branching.','Join neighboring dots horizontally or vertically. Every dot on the loop must connect exactly two lines. No branches or crossings.'],['Make one complete loop.','Solve the puzzle by satisfying every number and joining all your lines into one loop. No loose ends, and no separate loops.']],
 proof: [['No ads','Room to think'],['3 levels','Find your difficulty'],['30,000+','Puzzles to explore']], modesTitle: ['Settle into a puzzle.','Or rise to a challenge.'], standard: 'One puzzle at a time. At your pace.', standardText: 'Choose a board size and difficulty, then work your way through the stages. From compact grids to sprawling challenges, find a puzzle for your mood.', standardTags: ['4×4 to 16×20 grids','3 difficulty levels'], adventure: 'Add strategy to your logic.', adventureText: 'Choose buffs between stages and shape your own approach. Take on the daily challenge and compete for times on the rankings.', adventureTags: ['32 buffs','Daily challenge'], galleryLabel: 'Gameplay shown in current Japanese store images', endTitle: ['Your next move.','Your next adventure.'], endText: 'Bring your logic. Find your strategy. Download Loop Logic for free.', privacy: 'Privacy policy', terms: 'Terms of use', skip: 'Skip to content',
};
const canonical = `https://looplogic.overpatch.dev${ja ? '/ja/' : '/'}`;
const legal = ja ? '/ja/' : '/';
---
<!doctype html>
<html lang={lang}>
 <head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{c.title}</title><meta name="description" content={c.description} /><meta name="theme-color" content="#080b18" />
  <link rel="icon" href="/images/icon.png" type="image/png" /><link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="ja" href="https://looplogic.overpatch.dev/ja/" /><link rel="alternate" hreflang="en" href="https://looplogic.overpatch.dev/" /><link rel="alternate" hreflang="x-default" href="https://looplogic.overpatch.dev/" />
  <meta property="og:type" content="website" /><meta property="og:title" content={c.title} /><meta property="og:description" content={c.description} /><meta property="og:url" content={canonical} />
 </head>
 <body>
  <a class="skip" href="#main">{c.skip}</a>
  <header class="site-header"><div class="header wrap">
   <a class="brand" href={ja ? '/ja/' : '/'} aria-label="Loop Logic"><img src="/images/icon.png" width="40" height="40" alt="" /><span>Loop Logic</span></a>
   <nav aria-label={ja ? 'メインナビゲーション' : 'Main navigation'}><a href="#how">{c.nav[0]}</a><a href="#adventure">{c.nav[1]}</a></nav>
   <div class="header-actions"><a class="language" href={ja ? '/' : '/ja/'} lang={ja ? 'en' : 'ja'} data-language-choice={ja ? 'en' : 'ja'}>{ja ? 'EN' : '日本語'}</a><a class="small-cta" href="#download">{c.nav[2]}</a></div>
  </div></header>
  <LanguageSuggestion lang={lang} />
  <main id="main">
   <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow">{c.eyebrow}</p><h1>{c.headline[0]}<br /><span>{c.headline[1]}</span></h1><p class="intro">{c.intro}</p>

    </div>
    <FirstLoop ja={ja} />
   </section>
   <div class="proof wrap">{c.proof.map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</div>
   <section id="how" class="section wrap how"><div class="section-heading"><p class="eyebrow">HOW TO PLAY</p><h2>{c.rulesTitle[0]}<br />{c.rulesTitle[1]}</h2><p>{c.rulesIntro}</p></div>
    <div class="rules">{c.rules.map(([title,text],i)=><article><div class="rule-top"><span class="step">0{i+1}</span><svg viewBox="0 0 92 70" aria-hidden="true" class="rule-diagram">
       {i===0 ? <>
        <path class="rule-guide" d="M24 12V56" /><path d="M24 12H68V56H24" /><text x="46" y="36">3</text>
        {[[24,12],[68,12],[24,56],[68,56]].map(([x,y])=><circle cx={x} cy={y} r="2" />)}
       </> : i===1 ? <>
        <path d="M12 54H36V30H60V6H84" />
        {[[12,54],[36,54],[36,30],[60,30],[60,6],[84,6]].map(([x,y])=><circle cx={x} cy={y} r="2" />)}
       </> : <>
        <path class="rule-guide" d="M46 12V56" /><path d="M8 12H84V56H8Z" /><text x="27" y="36">3</text><text x="65" y="36">3</text>
        {[[8,12],[46,12],[84,12],[8,56],[46,56],[84,56]].map(([x,y])=><circle cx={x} cy={y} r="2" />)}
       </>}
      </svg></div><h3>{title}</h3><p>{text}</p></article>)}</div>
   </section>
   <AdventureStory ja={ja} />
   <section id="modes" class="section standard-section"><div class="wrap standard-layout"><div><p class="eyebrow">STANDARD MODE</p><h2>{ja ? 'ただ、パズルに' : 'Just you.'}<br/>{ja ? '没頭したい日にも。' : 'And the puzzle.'}</h2><p>{c.standardText}</p><div class="standard-facts"><strong>30,000+</strong><span>{ja ? '収録パズル' : 'puzzles to explore'}</span></div><ul>{c.standardTags.map(t=><li>{t}</li>)}</ul></div></div></section>
   <section id="download" class="download section wrap"><img src="/images/icon.png" width="76" height="76" alt="" loading="lazy" /><p class="eyebrow">LOOP LOGIC</p><h2>{c.endTitle[0]}<br />{c.endTitle[1]}</h2><p>{c.endText}</p><StoreLinks ja={ja} placement="footer" /></section>
  </main>
  <dialog class="image-dialog" aria-label={ja ? 'ゲーム画面を拡大' : 'Enlarged game screenshot'}>
   <form method="dialog"><button class="image-close" aria-label={ja ? '閉じる' : 'Close'} autofocus><span aria-hidden="true">×</span></button></form>
   <img alt="" width="1242" height="2688" />
  </dialog>
  <script>
   import '../scripts/screenshots';
  </script>
  <footer class="footer wrap"><div><a class="brand" href={ja?'/ja/':'/'}>Loop Logic</a><p>© {new Date().getFullYear()} overpatch</p></div><div class="footer-links"><a href={`${legal}privacy/`}>{c.privacy}</a><a href={`${legal}terms/`}>{c.terms}</a></div></footer>
 </body>
</html>
