---
const { lang, alternatePath } = Astro.props;
const target = lang === 'ja' ? 'en' : 'ja';
---
<aside class="language-suggestion" data-language-suggestion hidden lang={target} aria-label={target === 'ja' ? '表示言語の選択' : 'Language preference'}>
  <div class="language-suggestion-inner wrap">
    <p>{target === 'ja' ? '日本語で表示しますか？' : 'Would you prefer English?'}</p>
    <div class="language-suggestion-actions">
      <a href={alternatePath ?? (target === 'ja' ? '/ja/' : '/')} data-language-choice={target}>{target === 'ja' ? '日本語で表示' : 'View in English'}</a>
      <button type="button" data-language-dismiss aria-label={target === 'ja' ? '案内を閉じる' : 'Dismiss language suggestion'}>×</button>
    </div>
  </div>
</aside>

<script>
  import '../scripts/language-suggestion';
</script>

<style>
  .language-suggestion { background: #17152b; border-bottom: 1px solid var(--border); }
  .language-suggestion[hidden] { display: none; }
  .language-suggestion-inner { display: flex; align-items: center; justify-content: space-between; gap: 8px 24px; padding-block: 10px; flex-wrap: wrap; }
  .language-suggestion p { margin: 0; font-size: 1rem; }
  .language-suggestion-actions { display: flex; align-items: center; gap: 16px; margin-left: auto; }
  .language-suggestion a { display: inline-flex; align-items: center; min-height: 44px; font-size: .875rem; color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .language-suggestion button { width: 44px; height: 44px; border: 1px solid var(--border); border-radius: 50%; background: transparent; color: var(--text); font-size: 24px; cursor: pointer; }
  .language-suggestion button:hover { background: #ffffff12; }
</style>
