---
interface Props { ja: boolean; placement: string; }
const { ja, placement } = Astro.props;
const locale = ja ? 'ja' : 'en';
---
<div class="store-group">
 <div class="store-links">
  <a class="store-badge apple-badge" href={`https://apps.apple.com/${ja ? 'jp' : 'us'}/app/loop-logic/id6758883537`} data-store="apple" data-placement={placement}>
   <img src={`/images/badges/app-store-${locale}.svg`} width="120" height="40" alt={ja ? 'App Storeからダウンロード' : 'Download on the App Store'} />
  </a>
  <a class="store-badge google-badge" href="https://play.google.com/store/apps/details?id=ch.overpatch.looplogic" data-store="google" data-placement={placement}>
   <img src="/images/badges/google-play-en.png" width="646" height="250" alt={ja ? 'Google Playで手に入れよう' : 'Get it on Google Play'} />
  </a>
 </div>
 {placement === 'footer' && <div class="phone-handoff"><p>{ja ? 'スマホのカメラで読み取って、アプリをダウンロード' : 'Scan with your phone’s camera to download the app'}</p><div class="handoff-codes"><figure class="handoff-code"><img src={`/images/qr/app-store-${locale}.svg`} width="180" height="180" loading="lazy" alt={ja ? 'iPhone・iPad用：Loop LogicのApp Storeページを開くQRコード' : 'QR code to open Loop Logic on the App Store for iPhone and iPad'}/><figcaption>iPhone / iPad</figcaption></figure><figure class="handoff-code"><img src="/images/qr/google-play.svg" width="180" height="180" loading="lazy" alt={ja ? 'Android用：Loop LogicのGoogle Playページを開くQRコード' : 'QR code to open Loop Logic on Google Play for Android'}/><figcaption>Android</figcaption></figure></div></div>}
</div>
